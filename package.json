{
  "name": "amazon-music-mcp",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Amazon Music MCP server for Claude Desktop: play, search and control Amazon Music by driving the web player in a background Microsoft Edge window. No Amazon API.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-ui.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright-core": "^1.62.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-3.0-or-later",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude",
    "claude-desktop",
    "amazon-music",
    "music",
    "player",
    "lyrics",
    "browser-automation",
    "playwright",
    "edge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShadowsDistant/Amazon-Music-MCP.git"
  },
  "homepage": "https://github.com/ShadowsDistant/Amazon-Music-MCP#readme",
  "bugs": {
    "url": "https://github.com/ShadowsDistant/Amazon-Music-MCP/issues"
  }
}
